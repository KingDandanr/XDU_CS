# 
# Synthesis run script generated by Vivado
# 

set TIME_start [clock seconds] 
proc create_report { reportName command } {
  set status "."
  append status $reportName ".fail"
  if { [file exists $status] } {
    eval file delete [glob $status]
  }
  send_msg_id runtcl-4 info "Executing : $command"
  set retval [eval catch { $command } msg]
  if { $retval != 0 } {
    set fp [open $status w]
    close $fp
    send_msg_id runtcl-5 warning "$msg"
  }
}
set_param xicom.use_bs_reader 1
set_msg_config -id {Common 17-41} -limit 10000000
create_project -in_memory -part xc7k160tfbg676-2

set_param project.singleFileAddWarning.threshold 0
set_param project.compositeFile.enableAutoGeneration 0
set_param synth.vivado.isSynthRun true
set_property webtalk.parent_dir D:/soc/EXPERIMENT/IO/IO.cache/wt [current_project]
set_property parent.project_path D:/soc/EXPERIMENT/IO/IO.xpr [current_project]
set_property default_lib xil_defaultlib [current_project]
set_property target_language VHDL [current_project]
set_property ip_output_repo d:/soc/EXPERIMENT/IO/IO.cache/ip [current_project]
set_property ip_cache_permissions {read write} [current_project]
read_vhdl -library xil_defaultlib {
  D:/soc/EXPERIMENT/IO/IO.srcs/sources_1/new/IO.vhd
  D:/soc/EXPERIMENT/IO/IO.srcs/sources_1/new/clk_div.vhd
  D:/soc/EXPERIMENT/IO/IO.srcs/sources_1/new/seg_dis.vhd
  D:/soc/EXPERIMENT/IO/IO.srcs/sources_1/new/IO_test.vhd
}
# Mark all dcp files as not used in implementation to prevent them from being
# stitched into the results of this synthesis run. Any black boxes in the
# design are intentionally left as such for best results. Dcp files will be
# stitched into the design at a later time, either when this synthesis run is
# opened, or when it is stitched into a dependent implementation run.
foreach dcp [get_files -quiet -all -filter file_type=="Design\ Checkpoint"] {
  set_property used_in_implementation false $dcp
}
read_xdc D:/soc/EXPERIMENT/IO/IO.srcs/constrs_1/new/IO.xdc
set_property used_in_implementation false [get_files D:/soc/EXPERIMENT/IO/IO.srcs/constrs_1/new/IO.xdc]

set_param ips.enableIPCacheLiteLoad 1
close [open __synthesis_is_running__ w]

synth_design -top IO_test -part xc7k160tfbg676-2


# disable binary constraint mode for synth run checkpoints
set_param constraints.enableBinaryConstraints false
write_checkpoint -force -noxdef IO_test.dcp
create_report "synth_1_synth_report_utilization_0" "report_utilization -file IO_test_utilization_synth.rpt -pb IO_test_utilization_synth.pb"
file delete __synthesis_is_running__
close [open __synthesis_is_complete__ w]
